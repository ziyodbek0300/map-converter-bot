# Copy this file to .env and fill in your token from @BotFather.
BOT_TOKEN=123456:ABC-your-token-here

# Optional: comma-separated Telegram user IDs allowed to run /stats.
# ADMIN_IDS=111111111,22222222

# Optional: structured log verbosity — debug | info | warn | error (default: info).
# LOG_LEVEL=info

# Optional: short-link expansion tuning (defaults shown).
# EXPAND_MAX_ATTEMPTS=3
# EXPAND_RETRY_DELAY_MS=400
# EXPAND_CACHE_TTL_MS=86400000
# EXPAND_CACHE_MAX_SIZE=1000
